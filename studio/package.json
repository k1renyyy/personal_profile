{
  "name": "kiren-portfolio-cms-poc",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "dev": "sanity dev",
    "lint": "eslint . --max-warnings=0",
    "start": "sanity start",
    "test": "vitest run --configLoader runner",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^6.11.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.11.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "6.0.0",
    "@types/react": "^19.2.14",
    "eslint": "9.39.5",
    "prettier": "^3.5",
    "typescript": "^5.8",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "4.3.1",
      "smol-toml": "1.8.0"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    }
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
